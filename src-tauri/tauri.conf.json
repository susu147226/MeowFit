{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeowFit",
  "mainBinaryName": "MeowFit",
  "version": "0.1.3",
  "identifier": "com.susu147226.meowfit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "喵尺 MeowFit",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "云舒眠眠",
    "copyright": "© 2026 云舒眠眠。保留所有权利。",
    "shortDescription": "本地媒体尺寸批量调整工具",
    "longDescription": "喵尺 MeowFit 用于批量调整图片、动图与视频的尺寸。全部处理在本机完成，不发起任何网络请求。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/ffmpeg/win-x64/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
