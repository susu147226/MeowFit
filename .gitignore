# ============================================================
# 喵尺 MeowFit — .gitignore
# 规范第 21.3 条：config/ logs/ output/ node_modules/ target/ 以及
# FFmpeg 二进制等一律不得纳入版本控制。
# ============================================================

# ---------- 运行期数据（第 21.3 条；锚定到仓库根，避免误伤同名源码目录）----------
/config/
/logs/
/output/

# ---------- 日志 ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Node ----------
node_modules/

# ---------- 前端构建产物 ----------
dist/
dist-ssr/
*.local

# ---------- Rust / Tauri ----------
target/
src-tauri/target/
src-tauri/gen/schemas/

# ---------- FFmpeg 二进制（第 21.3 条 / 附录 B 第 16 项：默认不入库）----------
# 仅忽略可执行文件，目录结构与说明文件保留；获取方式见 README。
src-tauri/resources/ffmpeg/**/*.exe
src-tauri/resources/ffmpeg/**/*.dll

# ---------- 构建中间产物（scripts/build-ffmpeg-gpl.sh 的工作目录）----------
/build/

# ---------- 打包产物 ----------
/artifacts/
*.msi
*.nsis.zip

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp
*.bak
